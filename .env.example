# Data: Zetaris
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_DB=whybill

# Power: Meterless Nightshift (primary)
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN=
NIGHTSHIFT_APP_ID=why-my-bill
# Leave unset: each call gets a fresh scope, so Nightshift injects no earlier
# answers into prompts. "user" turns Nightshift's own memory back on.
NIGHTSHIFT_SCOPE=
# meterless/* modes route to on-device Llama on this machine, so name Nemotron explicitly.
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b

# The orchestrator (Nemotron Ultra) reasons before it plans and reviews.
# Benchmark: 95% of planted problems sent back with reasoning, 59% without.
ORCHESTRATOR_THINKING=true

# Model calls: this many a minute, started evenly (30: one every 2 s), and at
# most LLM_CONCURRENCY at once. The NVIDIA allowance is 40 a minute, but it
# rejects bursts (429), and Nightshift retries each rejection four times
# itself, so 30 leaves room. After a 429, calls back off and go at half rate.
LLM_RPM=30
LLM_CONCURRENCY=4

# The longest a question about one bill may take on the page; each further
# bill in the question adds half of it. Past it, no more model calls are sent
# and code finishes the answer from the measurements, saying so.
QUESTION_TIME_LIMIT_S=240

# The NVIDIA key lives in Nightshift, not in this project.

# Build: Meterless H-MEM
HMEM_PATH=.memory

# Server. The SAMPLE household's area (postcode district, price region,
# coordinates, water company) is in data/sample/household_SAMPLE.json,
# made by scripts/lookup_area.ts.
PORT=5175

# Scout signs execution contracts with this (HMAC-SHA256). Create it yourself:
#   openssl rand -hex 32
SCOUT_SECRET=

# Where answers come from: preview (hand-written SAMPLE answers, the default
# until the agent exists), replay (recorded agent answers) or live (the agent).
WHYBILL_MODE=preview
